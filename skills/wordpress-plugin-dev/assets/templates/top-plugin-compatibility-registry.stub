<?php
/**
 * Compatibility registry for popular WordPress ecosystem plugins.
 */

namespace {{VENDOR_NAMESPACE}}\{{PLUGIN_SLUG}}\Compatibility;

final class TopPluginCompatibilityRegistry {
	/**
	 * Use slugs as watchlist identifiers. Detect active status from installed
	 * plugin basenames so unusual main file names do not fatal.
	 *
	 * @var array<string,array{area:string,notes:string}>
	 */
	private const WATCHLIST = array(
		'woocommerce'   => array(
			'area'  => 'commerce',
			'notes' => 'Avoid checkout/account/cart output conflicts, public cache leaks, duplicate emails, and order meta collisions.',
		),
		'elementor'     => array(
			'area'  => 'builder',
			'notes' => 'Do not load builder-specific code globally; guard by class/function detection and editor context.',
		),
		'wordpress-seo' => array(
			'area'  => 'seo',
			'notes' => 'Avoid duplicate canonical, robots, Open Graph, Twitter card, breadcrumb, and schema output.',
		),
	);

	/**
	 * @return array<string,array{area:string,notes:string,active:bool}>
	 */
	public function get_detected_statuses(): array {
		$statuses = array();

		foreach ( self::WATCHLIST as $slug => $details ) {
			$statuses[ $slug ] = array(
				'area'   => $details['area'],
				'notes'  => $details['notes'],
				'active' => $this->is_plugin_slug_active( $slug ),
			);
		}

		return $statuses;
	}

	public function is_plugin_slug_active( string $slug ): bool {
		foreach ( $this->get_active_plugin_files() as $plugin_file ) {
			if ( str_starts_with( $plugin_file, $slug . '/' ) || $plugin_file === $slug . '.php' ) {
				return true;
			}
		}

		return false;
	}

	/**
	 * @return string[]
	 */
	private function get_active_plugin_files(): array {
		$active = get_option( 'active_plugins', array() );

		if ( is_multisite() ) {
			$network_active = array_keys( (array) get_site_option( 'active_sitewide_plugins', array() ) );
			$active         = array_merge( (array) $active, $network_active );
		}

		return array_values(
			array_filter(
				array_map( 'sanitize_text_field', (array) $active ),
				static fn ( string $plugin_file ): bool => '' !== $plugin_file
			)
		);
	}
}
