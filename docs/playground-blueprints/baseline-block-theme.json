{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "wordpress.org/themes",
        "slug": "twentytwentyfive"
      },
      "options": {
        "activate": true,
        "importStarterContent": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Compatibility Baseline",
        "blogdescription": "Block theme smoke environment"
      }
    }
  ]
}
